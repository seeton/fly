# 仮想環境 / キャッシュ
.venv/
.python/
__pycache__/
*.pyc
.ipynb_checkpoints/

# 巨大な生データと生成物 (再取得・再生成できる)
data/
out/

# PyInstaller の出力
build/
dist/
*.spec

# ローカル固有・ログ
.claude/settings.local.json
MUJOCO_LOG.TXT

# 学習済みのパラメータだけは残す (小さい・再学習に時間がかかる)
!out/
out/*
!out/*.json
# 五目並べの網 (700 KB)。アプリがこれで打つ。linerush は自己対戦が崩れたときの記録
!out/gomoku_net.pt
!out/gomoku_net_linerush.pt

# Claude 用のローカルメモ (引き継ぎメモも含む)
CLAUDE.md
HANDOFF.md

# 外部エンジン (Rapfi) のソースとビルド物。物差しとして使うだけで同梱しない
tools/
